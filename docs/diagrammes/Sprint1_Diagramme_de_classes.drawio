<mxfile host="app.diagrams.net" agent="Campus ReUse" version="24.0.0"><diagram name="Sprint 1 — Diagramme de classes" id="d0"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="702" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Sprint 1 — Gestion des comptes : diagramme de classes&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- id : int&lt;br&gt;- name : string&lt;br&gt;- prenom : string&lt;br&gt;- email : string {unique}&lt;br&gt;- password : string (haché)&lt;br&gt;- role : {etudiant, admin}&lt;br&gt;- filiere : string&lt;br&gt;- niveau : string&lt;br&gt;- etablissement : string&lt;br&gt;- photo : string&lt;br&gt;- bloque : bool = false&lt;br&gt;- notifications_email : bool = true&lt;br&gt;- email_verified_at : datetime&lt;br&gt;- created_at : datetime&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ inscrire(données) : User&lt;br&gt;+ seConnecter(email, mdp) : Token&lt;br&gt;+ seDeconnecter() : void&lt;br&gt;+ confirmerEmail(id, hash) : void&lt;br&gt;+ modifierProfil(données, photo) : User&lt;br&gt;+ supprimerCompte() : void&lt;br&gt;+ isAdmin() : bool&lt;br&gt;+ veutEmails() : bool&lt;br&gt;+ getPhotoUrl() : string&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="260" height="397" as="geometry"/></mxCell><mxCell id="c4" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;«Sanctum»&lt;br&gt;&lt;b&gt;PersonalAccessToken&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- id : int&lt;br&gt;- name : string&lt;br&gt;- token : string (haché)&lt;br&gt;- last_used_at : datetime&lt;br&gt;- created_at : datetime&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ supprimer() : void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="90" width="230" height="156" as="geometry"/></mxCell><mxCell id="c5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;PasswordResetToken&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;- email : string&lt;br&gt;- token : string (haché)&lt;br&gt;- created_at : datetime&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ estExpire() : bool  (30 min)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="760" y="330" width="230" height="112" as="geometry"/></mxCell><mxCell id="c6" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Etudiant&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;role = etudiant&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ supprimerCompte() : void&lt